	partition DailyRollup = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5433", "iot"),
				    Table1 = Source{[Schema="public",Item="daily_rollup",Kind="Table"]}[Data],
				    Typed = Table.TransformColumnTypes(Table1, {{"rollup_date", type date}, {"location", type text}, {"avg_temperature_c", type number}, {"max_temperature_c", type number}, {"avg_humidity_pct", type number}, {"reading_count", Int64.Type}, {"computed_at", type datetime}})
